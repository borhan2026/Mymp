rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email == 'mshibli878@gmail.com';
    }
    function signedIn() { return request.auth != null; }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create, update: if signedIn() && request.auth.uid == uid;
      allow delete: if isAdmin();
    }

    match /public/{docId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /chats/{chatId} {
      allow read: if signedIn() && (isAdmin() || request.auth.uid in resource.data.members);

      allow create: if isAdmin()
        || (signedIn()
            && chatId == 'dm_' + request.auth.uid
            && request.resource.data.type == 'dm'
            && request.resource.data.userId == request.auth.uid
            && request.resource.data.members == [request.auth.uid]);

      allow update: if isAdmin()
        || (signedIn()
            && chatId == 'dm_' + request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['lastText', 'lastAt', 'lastSender', 'userName']))
        || (signedIn()
            && resource.data.type == 'group'
            && resource.data.get('memberWrite', false) == true
            && request.auth.uid in resource.data.members
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['lastText', 'lastAt', 'lastSender']));

      allow delete: if isAdmin();

      match /messages/{mid} {
        allow read: if signedIn() && (isAdmin()
          || request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members);

        allow create: if signedIn()
          && request.resource.data.senderId == request.auth.uid
          && (isAdmin()
              || chatId == 'dm_' + request.auth.uid
              || (get(/databases/$(database)/documents/chats/$(chatId)).data.get('memberWrite', false) == true
                  && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members));

        allow update, delete: if isAdmin();
      }

      match /typing/{uid} {
        allow read: if signedIn() && (isAdmin()
          || chatId == 'dm_' + request.auth.uid
          || request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members);

        allow write: if signedIn() && request.auth.uid == uid
          && (isAdmin()
              || chatId == 'dm_' + request.auth.uid
              || request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members);
      }
    }

    /* ডেটা সিঙ্ক: ছাত্র, রেজাল্টসহ সর্বজনীন তথ্য সবাই পড়তে পারবে, রসিদ ইত্যাদি শুধু এডমিন */
    match /kv/{key} {
      allow read: if key in ['students','resultConfigs','notices','lessons','lessonConfigs','slides','syllabus','teachers','settings'] || isAdmin();
      allow write: if isAdmin();

      match /parts/{i} {
        allow read: if key in ['students','resultConfigs','notices','lessons','lessonConfigs','slides','syllabus','teachers','settings'] || isAdmin();
        allow write: if isAdmin();
      }
    }
  }
}
